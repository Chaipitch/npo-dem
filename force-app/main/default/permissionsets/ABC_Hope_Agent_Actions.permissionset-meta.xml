<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>ABC Hope Agent Actions</label>
    <description
  >Lets the ABC Hope Donor Assistant agent user run its Apex actions. Each action enforces verified-donor scoping itself.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>TSAbcHopeAgentCampaignInfo</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TSAbcHopeAgentGivingSummary</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TSAbcHopeAgentMonthlyGifts</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TSAbcHopeAgentUpdateProfile</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
