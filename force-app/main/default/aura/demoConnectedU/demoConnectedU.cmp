<aura:component implements="forceCommunity:themeLayout">
	<aura:attribute name="search" type="Aura.Component[]" required="false" />
	<aura:attribute name="navBar" type="Aura.Component[]" required="false" />
  	<aura:attribute name="profileMenu" type="Aura.Component[]" required="true" />
  	
	<div class="connectedU" style="overflow-x: hidden;">

		<!-- ****** header ***** -->
		<header class="header navbar">
			<div class="slds-grid slds-gutters nav">
				<div class="slds-col slds-size_5-of-12 slds-medium-size_2-of-12 slds-large-size_2-of-12 logo"><c:QBranchBrandLogo></c:QBranchBrandLogo></div>
				<nav class="slds-col slds-size_4-of-12 slds-medium-size_8-of-12 slds-large-size_8-of-12 navmenu">{!v.navBar}</nav>
				<div class="slds-col slds-size_3-of-12 slds-medium-size_2-of-12 slds-large-size_2-of-12 profileMenu">
					<div class="profileItems">
						<div><forceCommunity:notifications/></div>
						<div>{!v.profileMenu}</div>
					</div>
				</div>
			</div>
		</header>

		<!-- ****** body ***** -->
		<section class="content">
			{!v.body}
		</section>

		<!-- ****** footer ***** -->
		<footer class="footer">
			<div class="slds-col links">
				<div class="container slds-grid slds-wrap slds-gutters">
					<div class="slds-col slds-medium-size_4-of-12 slds-large-size_4-of-12 social-media">

						<div class="slds-grid slds-wrap">
							<div class="slds-col">
								<!-- social media icons -->
								<div>
									<ul class="slds-list_horizontal">
										<li>
											<span class="fa-stack fa-xs">
												<i class="fa-light fa-circle fa-stack-2x"></i>
												<i class="fab fa-instagram fa-stack-1x fa-inverse"></i>
											</span>
										</li>
										<li>
											<span class="fa-stack fa-xs">
												<i class="fa-light fa-circle fa-stack-2x"></i>
												<i class="fab fa-twitter fa-stack-1x fa-inverse"></i>
											</span>
										</li>
										<li>
											<span class="fa-stack fa-xs">
												<i class="fa-light fa-circle fa-stack-2x"></i>
												<i class="fab fa-linkedin-in fa-stack-1x fa-inverse"></i>
											</span>
										</li>
										<li>
											<span class="fa-stack fa-xs">
												<i class="fa-light fa-circle fa-stack-2x"></i>
												<i class="fab fa-facebook-f fa-stack-1x fa-inverse"></i>
											</span>
										</li>
									</ul>
								</div>
							</div>
							<div class="slds-col">
								<!-- address -->
								<p>1 Market St</p>
								<p>San Francisco, CA 94105</p>
								<p>(100) 123-4567</p>
							</div>
						</div>

					</div>
					<div class="slds-col slds-medium-size_8-of-12 slds-large-size_8-of-12 footer-links">

						<!-- Links -->
						<div class="slds-grid slds-wrap slds-gutters link-cols">
							<div class="slds-col slds-size_12-of-12 slds-medium-size_4-of-12 slds-large-size_4-of-12">
								<!-- Stay Involved -->
								<h3>Stay Involved</h3>
								<ul>
									<li>What We Do</li>
									<li>Who We Are</li>
									<li>How to Help</li>
									<li>Contact Us</li>
									<li>Careers</li>
								</ul>
							</div>
							<div class="slds-col slds-size_12-of-12 slds-medium-size_8-of-12 slds-large-size_8-of-12">
								<!-- Stay Informed -->
								<h3>Who We Serve</h3>
						
                                    <img src="https://sfdo-ngo-ido.s3.us-east-2.amazonaws.com/ido-community-images/GraphWhiteText.png"/>

							
							</div>
						</div>
						
					</div>	
				</div>
			</div>
			<div class="slds-col legal">
				<ul class="slds-list_horizontal">
					<li><a href="#">Legal</a></li>
					<li><a href="#">Terms of Service</a></li>
					<li><a href="#">Privacy Info</a></li>
					<li><a href="#">Responsible Disclosure</a></li>
					<li><a href="#">Trust</a></li>
					<li><a href="#">Contact</a></li>
					<li><a href="#">Manage Cookies</a></li>
				</ul>
				<p>
					&copy; 2023 Salesforce
					&nbsp;•&nbsp;
					This is a demo site for Salesforce demo purposes only.
				</p>
			</div>
		</footer>

	</div>
</aura:component>