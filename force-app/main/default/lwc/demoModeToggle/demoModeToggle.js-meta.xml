<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Demo Mode Toggle</masterLabel>
    <description>Toggles the running User's Demo_Mode__c field. Designed for the Global Actions menu.</description>
    <targets>
        <target>lightning__GlobalAction</target>
        <target>lightning__RecordAction</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__GlobalAction">
            <actionType>ScreenAction</actionType>
        </targetConfig>
        <targetConfig targets="lightning__RecordAction">
            <actionType>ScreenAction</actionType>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property
                name="refreshDelaySeconds"
                type="Integer"
                label="Refresh Delay (seconds)"
                description="How long to wait after saving before the page reloads, allowing component-visibility rules to pick up the new Demo Mode value. Default 5."
                default="5"
                min="0"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>