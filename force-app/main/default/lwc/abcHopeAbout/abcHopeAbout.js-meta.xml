<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ABC Hope About</masterLabel>
    <description
  >Public About page with placeholder demo copy, editable in Experience Builder (D-26).</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="heading"
        type="String"
        label="Heading"
        default="About ABC Hope"
      />
            <property
        name="lead"
        type="String"
        label="Lead"
        default="ABC Hope helps children and their communities learn, stay healthy and grow — one campaign at a time."
      />
            <property
        name="paragraphs"
        type="String"
        label="Paragraphs (separate with |)"
      />
            <property
        name="facts"
        type="String"
        label="Facts (value|label; …)"
        default="8,400|People reached;12|Communities;6|Programs;125|Volunteers"
      />
            <property
        name="demoNote"
        type="String"
        label="Demo note"
        default="This is a demo site. Payment simulation only — no money is collected."
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
